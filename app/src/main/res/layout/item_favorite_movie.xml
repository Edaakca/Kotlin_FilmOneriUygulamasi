<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">


    <ImageView
        android:id="@+id/moviePosterImageView"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="16dp" />


    <TextView
        android:id="@+id/movieTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/moviePosterImageView"
        android:layout_alignTop="@id/moviePosterImageView"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="10sp"/>


    <Button
        android:id="@+id/removeFavoriteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/movieTitleTextView"
        android:layout_alignStart="@id/movieTitleTextView"
        android:layout_marginTop="25dp"
        android:padding="10sp"
        android:backgroundTint="#1B1F3B"

        android:textColor="@android:color/white"
        android:text="Kaldır" />

</RelativeLayout>
